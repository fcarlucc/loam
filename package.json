{
  "name": "loam",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:raw": "node scripts/dev.mjs --no-ollama",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -H 127.0.0.1",
    "lint": "eslint",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test:api": "node --test --test-concurrency=1 tests/e2e/api.test.mjs tests/e2e/migration.test.mjs",
    "test:unit": "node --test --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"tests/unit/*.test.mjs\"",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "katex": "^0.16.47",
    "mermaid": "^12.2.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
