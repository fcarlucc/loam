{
  "name": "ollama-wrap",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:raw": "node scripts/dev.mjs --no-ollama",
